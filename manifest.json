{
  "manifest_version": 3,
  "name": "Menu Bar Overlay",
  "version": "1.0.0",
  "description": "A cosmetic, hover-revealed fake macOS menu bar overlay for webpages. For theming, UI demos, mockups and screenshots.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
